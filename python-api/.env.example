# Copie este arquivo para .env e preencha os valores no seu ambiente.
# Não envie nem publique o .env com credenciais reais.

# Banco já utilizado pelo projeto.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_da_arte

# Mantenha o mesmo segredo entre os processos da API.
# Gere um segredo longo e aleatório antes de executar em produção.
SECRET_KEY=substitua_por_um_segredo_longo_e_aleatorio

# SMTP autenticado. Não use sua senha pessoal se o provedor exigir
# senha de aplicativo ou credencial SMTP específica.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=projetomusicosfacepedesenvolvi@gmail.com
SMTP_PASSWORD=senha
SMTP_FROM_EMAIL=projetomusicosfacepedesenvolvi@gmail.com
SMTP_FROM_NAME=Portal da Arte

# starttls: geralmente porta 587; ssl: geralmente porta 465.
# A conexão sempre exige TLS com verificação do certificado do servidor.
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15

# URL do FRONTEND (não da API). O token é acrescentado automaticamente.
# Em produção, use a URL HTTPS pública da tela de login.
# Em desenvolvimento local, HTTP é aceito apenas em localhost/127.0.0.1/::1.
PASSWORD_RESET_URL=http://localhost:8081/pages/login/login

# Links expiram em 30 minutos; somente o hash é armazenado no banco.
# Limites da conta: 1 link a cada 60 segundos e até 5 links por hora.
# Limite IP: 10 solicitações em 15 minutos, em memória por processo.
# Em múltiplos workers, complemente o limite IP no proxy/API gateway.
# Configure o proxy de confiança do Uvicorn para o IP real do cliente;
# a aplicação não confia diretamente em cabeçalhos X-Forwarded-For.

# Portfólio: arquivos no Supabase Storage; dados e login continuam no MySQL.
# Execute BancoDeDados/supabase_portfolio_bucket.sql no SQL Editor do Supabase.
# Aplique BancoDeDados/migracao_portfolio_supabase.sql no MySQL existente.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave secreta da API, disponível em Settings > API Keys no Supabase.
# Cole a chave real SOMENTE no .env deste backend. Não use EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=
# Alternativa para projetos que ainda usam a chave legacy service_role:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PORTFOLIO_BUCKET=portfolios

# Limite por arquivo em MiB (50 = 52.428.800 bytes). O bucket também limita.
PORTFOLIO_MAX_FILE_MB=50
SUPABASE_STORAGE_TIMEOUT_SECONDS=60
